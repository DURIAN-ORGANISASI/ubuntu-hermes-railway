# Example only. Replace these values before using outside Railway.
# Never commit real terminal passwords, provider API keys, or channel tokens.
TERMINAL_USER=replace_with_unique_username
TERMINAL_PASSWORD=replace_with_a_unique_random_password_at_least_24_chars
TZ=Asia/Jakarta
HERMES_HOME=/opt/data
HERMES_RUNTIME_DIR=/usr/local/share/hermes-tools
UV_CACHE_DIR=/tmp/uv-cache
HERMES_AUTOSTART=true

# Railway injects PORT for a public service. Do not hard-code it here.
# Add Telegram/Discord credentials only if intentionally configuring them as
# environment variables; the documented first-run path is hermes gateway setup.
